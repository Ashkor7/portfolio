# ─────────────────────────────────────────────────────────────
# Variáveis PÚBLICAS (prefixo VITE_) — embutidas no bundle do navegador.
# Nunca coloque segredos aqui.
# ─────────────────────────────────────────────────────────────

# URL pública final do site (sem barra no fim). Usada em canonical, Open Graph,
# sitemap.xml e robots.txt. Sem ela, o build omite o sitemap e as URLs absolutas.
VITE_SITE_URL=

# Endpoint que recebe o formulário de contato. Padrão: função serverless /api/contact.
VITE_CONTACT_ENDPOINT=/api/contact

# ─────────────────────────────────────────────────────────────
# Variáveis de SERVIDOR — configure no painel da Vercel (Settings → Environment Variables).
# Ficam apenas na função /api/contact; nunca chegam ao navegador.
# ─────────────────────────────────────────────────────────────

# Chave da API do Resend (https://resend.com). Sem ela, o formulário responde
# "canal indisponível" — nenhum envio é simulado.
RESEND_API_KEY=

# E-mail que RECEBE as mensagens do formulário (o seu e-mail validado).
CONTACT_TO_EMAIL=

# Remetente verificado no Resend, ex.: "Portfólio <contato@seudominio.com>".
CONTACT_FROM_EMAIL=
